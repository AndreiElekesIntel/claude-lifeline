{
  "name": "claude-lifeline",
  "productName": "Claude Lifeline",
  "version": "1.1.0",
  "description": "Keeps Claude Code sessions alive \u2014 detects API errors and other turn-ending failures, then resumes the session automatically.",
  "main": "src/main/main.js",
  "author": "aelekes",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "node scripts/lint.mjs",
    "install-hook": "node scripts/cli.mjs install",
    "uninstall-hook": "node scripts/cli.mjs uninstall",
    "doctor": "node scripts/cli.mjs doctor",
    "pin": "node scripts/cli.mjs pin",
    "shutdown-check": "node scripts/idle-shutdown.mjs --check",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "node scripts/make-icons.mjs",
    "prebuild:arm": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs --win --x64",
    "build:arm": "node scripts/build.mjs --win --arm64"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aelekes.claudelifeline",
    "productName": "Claude Lifeline",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!test/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
